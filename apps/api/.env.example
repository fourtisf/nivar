# --- NIVAR api ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Auth — REQUIRED in production (>=16 chars, not a default). The api refuses to
# start in production without a strong value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Accept a deterministic dev SIWS signature (NEVER set in production).
NIVAR_DEV_AUTH=1

# Persistence (Prisma / Postgres) — used by the production Store impl.
DATABASE_URL=postgresql://nivar:nivar@localhost:5432/nivar?schema=public

# Cache / locks (Redis) — used for per-user locks + rate limits in production.
REDIS_URL=redis://localhost:6379

# Solana / Helius (milestone 8 — wallet + treasury). Keep secrets OUT of git.
HELIUS_API_KEY=
SOLANA_RPC_URL=
NIVAR_MINT=
TREASURY_SECRET_KEY=

# Feature flags
NIVAR_ENABLE_FIAT=0
